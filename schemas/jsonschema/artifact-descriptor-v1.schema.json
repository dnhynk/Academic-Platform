{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-os.invalid/schema/artifact-descriptor-v1.json",
  "title": "Academic OS artifact descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "content_digest",
    "media_type",
    "byte_length",
    "domain_id",
    "confidentiality",
    "retention_class",
    "permission_lineage_id",
    "format_version",
    "vault_locator",
    "evidence_representations"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/uuidV7" },
    "content_digest": { "$ref": "#/$defs/digest" },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "byte_length": { "type": "integer", "minimum": 0 },
    "domain_id": { "$ref": "#/$defs/uuidV7" },
    "confidentiality": {
      "enum": ["PUBLIC", "PERSONAL", "RESTRICTED", "SECRET"]
    },
    "retention_class": {
      "enum": ["EPHEMERAL", "COURSE_TERM", "USER_MANAGED", "LEGAL_HOLD"]
    },
    "permission_lineage_id": { "$ref": "#/$defs/uuidV7" },
    "format_version": { "const": 1 },
    "vault_locator": {
      "type": "string",
      "pattern": "^locator:v1:[0-9a-f]{64}$"
    },
    "evidence_representations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceRepresentation" }
    }
  },
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "logicalPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!~)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^:\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "evidenceLocator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "page_number"],
          "properties": {
            "kind": { "const": "PAGE" },
            "page_number": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source_digest", "start", "end"],
          "properties": {
            "kind": { "const": "TEXT_BYTES" },
            "source_digest": { "$ref": "#/$defs/digest" },
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "start_ms", "end_ms"],
          "properties": {
            "kind": { "const": "TRANSCRIPT_TIME" },
            "start_ms": { "type": "integer", "minimum": 0 },
            "end_ms": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "snapshot_digest", "path", "start", "end"],
          "properties": {
            "kind": { "const": "REPOSITORY_BYTES" },
            "snapshot_digest": { "$ref": "#/$defs/digest" },
            "path": { "$ref": "#/$defs/logicalPath" },
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "evidenceRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "content_digest", "byte_length"],
      "properties": {
        "locator": { "$ref": "#/$defs/evidenceLocator" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "byte_length": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
