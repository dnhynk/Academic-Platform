{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-os.invalid/schema/signed-batch-fixture-v2.json",
  "title": "Academic OS deterministic signed batch fixture v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_version",
    "name",
    "data_class",
    "network_egress",
    "contract",
    "device_id",
    "user_id",
    "public_key_hex",
    "signed_batch_cbor_hex",
    "expected_replay"
  ],
  "properties": {
    "fixture_version": { "const": 2 },
    "name": { "type": "string", "minLength": 1 },
    "data_class": { "const": "SYNTHETIC_ONLY" },
    "network_egress": { "const": "NONE" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope", "payload", "signature", "event_schema_version"],
      "properties": {
        "envelope": { "const": "academic.signed-batch-envelope/v1 deterministic-cbor" },
        "payload": { "const": "academic.event-batch/v2 deterministic-cbor" },
        "signature": { "const": "Ed25519" },
        "event_schema_version": { "const": 2 }
      }
    },
    "device_id": { "$ref": "#/$defs/uuidV7" },
    "user_id": { "$ref": "#/$defs/uuidV7" },
    "public_key_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signed_batch_cbor_hex": {
      "type": "string",
      "minLength": 2,
      "pattern": "^(?:[0-9a-f]{2})+$"
    },
    "expected_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_events",
        "accept_seq_head",
        "payload_hash",
        "envelope_hash",
        "artifact_digest",
        "artifact_locator",
        "mastery",
        "freshness",
        "mastery_active_claim_ids",
        "mastery_conflicting_claim_ids",
        "mastery_rejected_claim_ids",
        "deadline_active_claim_ids",
        "prediction_claims",
        "semantic_digest"
      ],
      "properties": {
        "accepted_events": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "accept_seq_head": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "payload_hash": { "$ref": "#/$defs/digest" },
        "envelope_hash": { "$ref": "#/$defs/digest" },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "artifact_locator": {
          "type": "string",
          "pattern": "^locator:v1:[0-9a-f]{64}$"
        },
        "mastery": {
          "enum": ["UNSEEN", "EXPOSED", "UNDERSTOOD", "PRACTICED", "APPLIED", "FLUENT"]
        },
        "freshness": {
          "enum": ["UNKNOWN", "STALE", "LOW", "MODERATE", "HIGH", "VERY_HIGH"]
        },
        "mastery_active_claim_ids": { "$ref": "#/$defs/uuidArray" },
        "mastery_conflicting_claim_ids": { "$ref": "#/$defs/uuidArray" },
        "mastery_rejected_claim_ids": { "$ref": "#/$defs/uuidArray" },
        "deadline_active_claim_ids": { "$ref": "#/$defs/uuidArray" },
        "prediction_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/predictionClaimDisclosure" }
        },
        "semantic_digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuidArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/uuidV7" },
      "uniqueItems": true
    },
    "predictionClaimDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "confidence", "prediction_metadata", "valid_time"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/uuidV7" },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "prediction_metadata": { "$ref": "#/$defs/predictionMetadata" },
        "valid_time": { "$ref": "#/$defs/validInterval" }
      }
    },
    "predictionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "observation_window", "positive_sample_count"],
      "properties": {
        "version": { "const": 1 },
        "observation_window": { "$ref": "#/$defs/predictionObservationWindow" },
        "positive_sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "predictionObservationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "to": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "validInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "to": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
