engine engine.transcript.coverage
engine_version 1
rule_set_hash sha256:a7120cfa38d5b57d7a9a858ca196106a738c3c4ec39d485def3d1aefd02321e9
frozen_inputs sha256:3cd41db7cc63d20fa4fcd746d3bf138f13c170bf6b07316903ce95d2486ed3ee
result NEEDS
value segment_coverage_denominator=4/0
value segment_coverage_numerator=2/0
value token_coverage_denominator=20/0
value token_coverage_numerator=10/0
value unmapped_segments=2/0
proof
  NEEDS coverage.document-is-complete [n.complete] inputs=coverage.config.version,coverage.segments.eligible,coverage.segments.unmapped
    NOT_SATISFIED coverage.every-capture-is-placed-or-excluded [n.captures] inputs=coverage.captures.excluded,coverage.captures.placed,coverage.captures.unaccounted
    NOT_SATISFIED coverage.no-unexplained-hole-above-threshold [n.gaps] inputs=coverage.config.gap_threshold_nanos,coverage.gaps.total,coverage.gaps.unexplained
    NOT_SATISFIED coverage.order-is-monotonic-or-cross-referenced [n.ordering] inputs=coverage.ordering.exceptions,coverage.ordering.findings
    NEEDS coverage.every-segment-has-exactly-one-status [n.partition] inputs=coverage.segment.0000.status,coverage.segment.0001.status,coverage.segment.0002.status,coverage.segment.0003.status,coverage.segments.eligible,coverage.segments.unmapped
    NOT_SATISFIED coverage.render-has-no-defect [n.render] inputs=coverage.render.defects
    NOT_SATISFIED coverage.segment-coverage-is-whole [n.segments] inputs=coverage.segment_coverage.denominator,coverage.segment_coverage.numerator
    NOT_SATISFIED coverage.token-coverage-is-whole [n.tokens] inputs=coverage.token_coverage.denominator,coverage.token_coverage.numerator
